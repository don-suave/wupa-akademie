{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wupa-akademie",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "CLUB", "class_name": "Club" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Club"] }],
  "keep_vars": true,
  "observability": { "enabled": true }
}
